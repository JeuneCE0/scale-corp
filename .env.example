# ============================================================
# Scale Corp — Environment Variables
# Copy this file to .env and fill in your values
# All variables prefixed VITE_ are exposed to the client
# ============================================================

# ─── Supabase (required) ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbG...your-anon-key
SUPABASE_SERVICE_KEY=eyJhbG...your-service-role-key

# ─── GoHighLevel CRM (per location) ───
GHL_ECO_KEY=
GHL_LEADX_KEY=
GHL_BCS_KEY=
GHL_MODERMA_KEY=

# ─── GHL OAuth ───
GHL_OAUTH_CLIENT_ID=
GHL_OAUTH_CLIENT_SECRET=
GHL_WEBHOOK_SECRET=

# ─── Stripe ───
STRIPE_SECRET_KEY=sk_live_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# ─── Meta (Facebook) Ads ───
META_APP_ID=
META_APP_SECRET=

# ─── Google Ads ───
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# ─── TikTok Ads ───
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ─── Revolut Business ───
REVOLUT_OAUTH_CLIENT_ID=
REVOLUT_OAUTH_CLIENT_SECRET=

# ─── Qonto ───
QONTO_OAUTH_CLIENT_ID=
QONTO_OAUTH_CLIENT_SECRET=

# ─── KV Store ───
STORE_SECRET=your-store-auth-secret

# ─── Security ───
# Society PINs (comma-separated, for legacy PIN login)
SOC_PINS=

# ─── CORS (optional, comma-separated extra origins) ───
ALLOWED_ORIGINS=https://scale-corp.vercel.app

# ─── Sentry Error Monitoring ───
VITE_SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ─── Analytics (optional) ───
VITE_ANALYTICS_ENDPOINT=
